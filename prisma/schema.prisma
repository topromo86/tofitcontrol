// Prisma schema - toFitCONTROL (system zarządzania klubem; wdrożenie: Czapla Boxing)
// Źródło prawdy: SPEC.md sekcja 1. W razie konfliktu wygrywa CLAUDE.md.
//
// Konwencje:
// - Wszystkie id: cuid()
// - Wszystkie kwoty: Int (grosze), nigdy Float
// - Wszystkie momenty w czasie (DateTime bez czystej daty): @db.Timestamptz,
//   żeby Postgres trzymał je jako instant w UTC. Konwersja na Europe/Warsaw
//   dzieje się w aplikacji, nigdy w bazie. Patrz CLAUDE.md: pułapka ze strefami czasu.
// - Czyste daty kalendarzowe (birthDate, CashDay.date): @db.Date

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tożsamość i role
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  TRAINER
  MEMBER
  GUARDIAN
  // Konto urządzenia, nie człowieka: tablet na sali. Widzi wyłącznie kiosk
  // z kodem zajęć i skanerem - żadnej kartoteki, pieniędzy ani grafiku.
  // Hasło do niego zna cały klub, więc uprawnienia muszą być zerowe.
  KIOSK
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  name            String
  phone           String?
  role            Role
  // Dostęp do modułu leadów (CRM). ADMIN ma zawsze; trenerowi nadaje admin.
  canAccessLeads  Boolean   @default(false)
  // Osobisty token wejścia (QR). Wspólny dla klienta i trenera - odbicie
  // identyfikuje KONTO, więc "trener też się odbija" działa tym samym
  // mechanizmem. Generowany leniwie przy pierwszym wyświetleniu kodu. Bearer:
  // liczy się, że skan odbywa się na zaufanej stacji na sali.
  // Wymuszenie zmiany hasła przy najbliższym logowaniu. Ustawiane wszędzie
  // tam, gdzie hasło nadaje ktoś inny niż właściciel konta (skrypt kadrowy,
  // reset przez klub) - hasło znane dwóm osobom przestaje być hasłem.
  mustChangePassword Boolean @default(false)
  // Ostatnio wybrany motyw ("dark" / "light"). Trzymany przy KONCIE, a nie
  // tylko w przeglądarce: wybór ma jechać z człowiekiem na telefon, tablet
  // i drugi komputer. null = brak wyboru, czyli tak jak ustawiony system.
  theme           String?
  checkInToken    String?   @unique
  emailVerifiedAt DateTime? @db.Timestamptz
  lastLoginAt     DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  // pushSubscription to surowy obiekt PushSubscription z przeglądarki
  // (endpoint + klucze), zapisany po zgodzie użytkownika. To transport;
  // o tym, CO wysyłamy, decyduje NotificationPreference.
  pushSubscription Json?

  notificationPreferences NotificationPreference[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  guardianLinkRequests    GuardianLinkRequest[]    @relation("GuardianLinkRequester")

  trainer              Trainer?       @relation("TrainerAccount")
  memberAccount        Member?        @relation("MemberAccount")
  guardianOfMembers    Member[]       @relation("MemberGuardian")
  authoredNotes        Note[]         @relation("NoteAuthor")
  recordedAttendances  Attendance[]   @relation("AttendanceRecordedBy")
  soldPasses           Pass[]         @relation("PassSoldBy")
  recordedPayments     Payment[]      @relation("PaymentRecordedBy")
  closedCashDays       CashDay[]      @relation("CashDayClosedBy")
  grantedConsents      Consent[]      @relation("ConsentGrantedBy")
  activityLogs         ActivityLog[]  @relation("ActivityActor")
  recordedMeasurements Measurement[]  @relation("MeasurementRecordedBy")
  refundedEntries      Booking[]      @relation("BookingEntryRefundedBy")
  assignedLeads        Lead[]         @relation("LeadAssignee")
  leadNotes            LeadNote[]     @relation("LeadNoteAuthor")
  leadActivities       LeadActivity[] @relation("LeadActivityActor")
  floorCheckIns        FloorCheckIn[] @relation("FloorCheckInUser")
  recordedFloorCheckIns FloorCheckIn[] @relation("FloorCheckInRecorder")

  @@index([role])
}

model Location {
  id       String @id @default(cuid())
  name     String // "Mikołów" | "Tychy"
  address  String
  timezone String @default("Europe/Warsaw")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  trainers       Trainer[]       @relation("PrimaryLocation")
  trainersHere   Trainer[]       @relation("TrainerLocations")
  members        Member[]
  classTemplates ClassTemplate[]
  sessions       Session[]
  payments       Payment[]
  cashDays       CashDay[]

  availabilityWindows AvailabilityWindow[]
  costs               ClubCost[]
  floorCheckIns       FloorCheckIn[]
}

// Odbicie wejścia na salę osobistym kodem QR (skaner na sali). Osobne od
// Attendance (obecność na KONKRETNYCH zajęciach) - to surowy log wejść na
// obiekt, wspólny dla klientów i trenerów. Anti-"nabijanie": rejestruje realne
// pojawienie się na sali z godziną, a nie kliknięcie z domu. Wariant "tylko
// wejście": jedno odbicie = jedno wejście; kolejne w oknie floorMinMinutes jest
// traktowane jako to samo wejście (patrz lib/domain/floor-checkin.ts).
model FloorCheckIn {
  id               String   @id @default(cuid())
  userId           String
  locationId       String
  enteredAt        DateTime @default(now()) @db.Timestamptz
  // Kto obsługiwał stację skanera (opcjonalnie - stacja bywa kioskiem).
  recordedByUserId String?

  user           User     @relation("FloorCheckInUser", fields: [userId], references: [id], onDelete: Cascade)
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  recordedByUser User?    @relation("FloorCheckInRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, enteredAt])
  @@index([locationId, enteredAt])
}

model Trainer {
  id         String   @id @default(cuid())
  userId     String   @unique
  locationId String
  hiredAt    DateTime @db.Timestamptz
  // active=false to "wyciszenie": trener znika z list wyboru i z widoku
  // klientów, ale cała historia (sesje, oceny, wyniki) zostaje nietknięta.
  active     Boolean  @default(true)

  deactivatedAt DateTime? @db.Timestamptz

  // Wizytówka widoczna dla klientów. Zdjęcie trzymamy jako bajty w bazie i
  // serwujemy osobnym endpointem (app/api/trener/[trainerId]/zdjecie), a nie
  // jako data URI w HTML - inaczej każda odsłona listy trenerów ciągnęłaby
  // kilkaset kB niecacheowalnego base64.
  bio           String? @db.Text
  photo         Bytes?
  photoMimeType String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user      User       @relation("TrainerAccount", fields: [userId], references: [id], onDelete: Restrict)
  // location = lokalizacja domyślna (macierzysta). locations = wszystkie sale,
  // w których trener pracuje (M2M, zawiera też domyślną). Trener może być
  // przypisany do kilku lokalizacji treningowych - patrz /app/trenerzy i
  // przydział zastępstw.
  location  Location   @relation("PrimaryLocation", fields: [locationId], references: [id], onDelete: Restrict)
  locations Location[] @relation("TrainerLocations")

  ownedMembers           Member[]             @relation("OwnerTrainer")
  sparringClearedMembers Member[]             @relation("SparringClearer")
  classTemplates         ClassTemplate[]
  sessions               Session[]            @relation("SessionTrainer")
  substituteSessions     Session[]            @relation("SessionSubstitute")
  retentionTasks         RetentionTask[]
  scores                 TrainerScore[]
  availabilityWindows    AvailabilityWindow[]
  rates                  TrainerRate[]

  @@index([locationId, active])
}

// ---------------------------------------------------------------------------
// Klienci
// ---------------------------------------------------------------------------

enum MemberLevel {
  WHITE
  YELLOW
  ORANGE
  GREEN
}

enum MemberStatus {
  ACTIVE
  FROZEN
  CHURNED
}

// Stan akceptacji konta. Domyślnie APPROVED - dotyczy wszystkich kartotek
// zakładanych przez klub oraz samodzielnej rejestracji osób pełnoletnich.
// Samodzielna rejestracja osoby niepełnoletniej ląduje w PENDING i wymaga
// zatwierdzenia przez admina, zanim będzie mogła cokolwiek zarezerwować.
// REJECTED to świadoma odmowa - konto zostaje, ale pozostaje zablokowane.
enum ApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

enum Sex {
  MALE
  FEMALE
}

model Member {
  id                         String         @id @default(cuid())
  userId                     String?        @unique
  guardianUserId             String?
  ownerTrainerId             String
  homeLocationId             String
  firstName                  String
  lastName                   String
  email                      String? // kontakt na kartotece; osobny od loginu (User.email), nie musi byc unikalny
  birthDate                  DateTime       @db.Date
  isMinor                    Boolean // wyliczane z birthDate, przeliczane jobem
  sex                        Sex? // nieobowiązkowe - nieznane dla ręcznie dodanych starych kartotek
  weightKg                   Float?
  level                      MemberLevel    @default(WHITE)
  goal                       String?
  status                     MemberStatus   @default(ACTIVE)
  // Osobne od status: to nie retencja, tylko brama wejścia. Kartoteki zakładane
  // przez klub są APPROVED od razu; samodzielna rejestracja nieletniego czeka
  // w PENDING na zatwierdzenie admina. Kto zatwierdził i kiedy - do audytu.
  approvalStatus             ApprovalStatus @default(APPROVED)
  approvedAt                 DateTime?      @db.Timestamptz
  approvedByUserId           String?
  // Odbiór PODPISANYCH (papierowych) zgód, potwierdzony przez trenera/admina.
  // Zgody akceptuje się w aplikacji, ale wydruk trzeba dostarczyć podpisany.
  // Dopóki to null, klient może zapisać się tylko na pierwsze zajęcia - patrz
  // booking.ts (CONSENTS_NOT_DELIVERED). null = niedostarczone.
  consentsDeliveredAt        DateTime?      @db.Timestamptz
  consentsConfirmedByUserId  String?
  joinedAt                   DateTime?      @db.Timestamptz // pierwsza opłacona transakcja lub pierwsza obecność - NIE data założenia konta. null = jeszcze nie dołączył(a)
  churnedAt                  DateTime?      @db.Timestamptz
  sparringClearedAt          DateTime?      @db.Timestamptz
  sparringClearedByTrainerId String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user                     User?    @relation("MemberAccount", fields: [userId], references: [id], onDelete: SetNull)
  guardianUser             User?    @relation("MemberGuardian", fields: [guardianUserId], references: [id], onDelete: Restrict)
  ownerTrainer             Trainer  @relation("OwnerTrainer", fields: [ownerTrainerId], references: [id], onDelete: Restrict)
  homeLocation             Location @relation(fields: [homeLocationId], references: [id], onDelete: Restrict)
  sparringClearedByTrainer Trainer? @relation("SparringClearer", fields: [sparringClearedByTrainerId], references: [id], onDelete: SetNull)

  bookings             Booking[]
  attendances          Attendance[]
  notes                Note[]
  onboardingSteps      OnboardingStep[]
  retentionTasks       RetentionTask[]
  churnSurveys         ChurnSurvey[]
  ratings              Rating[]
  passes               Pass[]
  payments             Payment[]
  consents             Consent[]
  referralsMade        Referral[]            @relation("ReferralReferrer")
  referralsReceived    Referral[]            @relation("ReferralReferee")
  activityLogs         ActivityLog[]
  measurements         Measurement[]
  absenceReports       AbsenceReport[]
  guardianLinkRequests GuardianLinkRequest[] @relation("GuardianLinkMember")
  convertedLead        Lead?                 @relation("LeadMember")

  @@index([ownerTrainerId, status])
  @@index([approvalStatus])
  @@index([status, joinedAt])
  @@index([guardianUserId])
}

// ---------------------------------------------------------------------------
// Zajęcia
// ---------------------------------------------------------------------------

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

// Stawka trenera za poprowadzone zajęcia, osobno dla grupowych i
// indywidualnych. Z historią (validFrom), a nie jednym polem na Trainerze -
// podwyżka w połowie miesiąca nie może przeliczyć wstecz już poprowadzonych
// zajęć. To wypłata dla konkretnego człowieka, po cichu zmieniona kwota za
// zeszły miesiąc byłaby realnym problemem, nie kosmetyką.
model TrainerRate {
  id          String      @id @default(cuid())
  trainerId   String
  kind        SessionKind
  amountGross Int // grosze za jedne poprowadzone zajęcia
  validFrom   DateTime    @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, kind, validFrom])
  @@index([trainerId, kind, validFrom])
}

enum CostKind {
  RECURRING_MONTHLY
  ONE_OFF
}

// Koszty klubu: stałe miesięczne (czynsz, media) i jednorazowe (sprzęt,
// naprawa). Widoczne wyłącznie dla właściciela.
model ClubCost {
  id          String    @id @default(cuid())
  name        String
  amountGross Int // grosze
  kind        CostKind
  // RECURRING_MONTHLY: pierwszy miesiąc obowiązywania. ONE_OFF: data poniesienia.
  startsOn    DateTime  @db.Date
  // Tylko dla stałych: ostatni miesiąc obowiązywania, null = nadal obowiązuje.
  endsOn      DateTime? @db.Date
  note        String?   @db.Text
  locationId  String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([kind, startsOn])
}

enum BookingStatus {
  BOOKED
  WAITLIST
  CANCELLED
  NO_SHOW
  ATTENDED
}

enum AttendanceMethod {
  QR
  MANUAL
}

// Jak daleko w przód klient może się zapisywać.
// CURRENT_WEEK - do najbliższej niedzieli włącznie, reset w poniedziałek o
// północy (niezależnie od tego, czy dziś jest poniedziałek czy czwartek).
// FIXED_DAYS - stałe okno N dni do przodu (7/14/21/28).
enum BookingHorizonMode {
  CURRENT_WEEK
  FIXED_DAYS
}

// Ustawienia klubu - jeden wiersz (id="singleton"). Osobna tabela zamiast
// zmiennych środowiskowych, bo właściciel ma to zmieniać sam z panelu, bez
// wdrożenia.
model ClubSettings {
  id                 String             @id @default("singleton")
  bookingHorizonMode BookingHorizonMode @default(CURRENT_WEEK)
  bookingHorizonDays Int                @default(7)

  // Próg premii (wynik 0-100) i kwota premii w groszach. Wcześniej próg był
  // stałą w kodzie - właściciel ma go zmieniać sam po zobaczeniu realnych
  // wyników, bez wdrożenia.
  bonusThresholdScore Int @default(70)
  bonusAmountGross    Int @default(0)

  // Ile godzin przed startem odwołanie jest bezkosztowe. Wcześniej 4h zaszyte
  // w kodzie - właściciel zmienia to sam, bo reguła bywa negocjowana z
  // klubowiczami i nie powinna wymagać wdrożenia.
  freeCancellationHours Int @default(24)

  // Zestaw czcionek dla całej aplikacji (id z lib/domain/font-themes.ts).
  // Admin wybiera jeden, obowiązuje wszystkich. String, nie enum - dodanie
  // nowego zestawu nie wymaga wtedy migracji.
  fontTheme String @default("boxing")

  // Minimalny czas na sali (minuty) dla odbić QR. Po zeskanowaniu osobistego
  // kodu na stacji zapisujemy godzinę wejścia; wizyta liczy się jako ważna
  // dopiero, gdy minęło tyle minut - to gasi "nabijanie" (odbił i wyszedł).
  // Pełni też rolę okna anty-dublowania: powtórne odbicie tej samej osoby w
  // tym czasie to wciąż to samo wejście. 0 = brak wymogu.
  floorMinMinutes Int @default(0)

  // Kod QR zajęć pojawia się tyle minut przed startem. Nowy kod dla każdych
  // zajęć - zdjęcie wczorajszego ekranu nic nie daje.
  qrOpensMinutesBefore Int @default(15)

  // Do ilu minut przed startem trener ma odbić kod. Po tym czasie odbicie
  // liczy się jako spóźnione i trafia do właściciela na pulpit.
  trainerCheckInMinutesBefore Int @default(5)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
}

// Rodzaj zajęć (Boks Grupowy, Boks Grupowy Junior, Treningi Personalne...).
// Osobna tabela, a nie enum - właściciel dodaje i zmienia rodzaje sam, bez
// migracji bazy. Po tym polu działa filtrowanie plannera.
model ClassCategory {
  id           String  @id @default(cuid())
  name         String  @unique
  sortOrder    Int     @default(0)
  active       Boolean @default(true)
  // Rodzaj przypisywany automatycznie treningom indywidualnym - dokładnie
  // jeden taki wiersz, pilnowane częściowym indeksem unikalnym w migracji.
  isIndividual Boolean @default(false)
  // Kolor rodzaju na grafiku (klucz z palety, patrz lib/domain/class-color.ts).
  // null = kolor dobrany automatycznie z nazwy, więc grafik jest kolorowy
  // od razu, bez ustawiania czegokolwiek.
  color        String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  sessions       Session[]
  classTemplates ClassTemplate[]

  @@index([active, sortOrder])
}

// GROUP - zajęcia grupowe (z szablonu albo dodane ręcznie przez właściciela).
// INDIVIDUAL - trening 1:1, tworzony dopiero w chwili zapisu klienta na wolny
// slot z okna dostępności trenera (AvailabilityWindow), zawsze capacity = 1.
enum SessionKind {
  GROUP
  INDIVIDUAL
}

// Okno dostępności trenera na treningi indywidualne: "wtorki 16:00-20:00,
// sloty po 60 min". Klient nie wybiera dowolnej godziny - widzi wyłącznie
// sloty wyliczone z tych okien (lib/domain/availability.ts), więc zapis na
// 23:00 jest niemożliwy z definicji, a nie tylko ukryty w UI.
model AvailabilityWindow {
  id          String  @id @default(cuid())
  trainerId   String
  locationId  String
  weekday     Int // 0 = niedziela ... 6 = sobota (konwencja Date.getUTCDay)
  startTime   String // "16:00"
  endTime     String // "20:00"
  slotMinutes Int     @default(60)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  trainer  Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([trainerId, active])
}

model ClassTemplate {
  id          String  @id @default(cuid())
  locationId  String
  trainerId   String
  // Nazwa opcjonalna: puste = zajęcia nazywają się jak ich rodzaj (kategoria).
  // Właściwą nazwę wylicza resolveClassName z lib/domain/class-template.ts przy
  // generowaniu sesji - Session.name pozostaje wymagane.
  name        String?
  weekday     Int // 0-6
  startTime   String // "18:00"
  durationMin Int
  capacity    Int
  // Od kiedy plan obowiązuje. null = od zaraz. Zajęcia są cykliczne "do
  // odwołania" - trwają, dopóki active, koniec to wyłączenie planu (nie ma
  // daty końcowej). Trzymane jako północ czasu klubu w UTC.
  startDate   DateTime? @db.Timestamptz
  minAge      Int?
  maxAge      Int?
  isKids      Boolean @default(false)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  categoryId String?

  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  trainer  Trainer        @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  category ClassCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sessions Session[]
  skips    SessionSkip[]

  @@index([locationId, active])
}

// Wyjątek od planu cyklicznego: konkretny termin (templateId + startsAt), który
// admin usunął ręcznie z grafiku. generateSessions pomija te terminy, żeby raz
// usunięty termin nie wracał przy kolejnym generowaniu. startsAt trzymamy w UTC
// dokładnie jak w Session - klucz musi pasować do upsertu jobu.
model SessionSkip {
  id         String   @id @default(cuid())
  templateId String
  startsAt   DateTime @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz

  template ClassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, startsAt])
}

// Zastępstwo wymaga potwierdzenia przez zastępcę. Dopóki jest PENDING,
// prowadzącym pozostaje trener pierwotny - inaczej niepotwierdzone zastępstwo
// zostawiłoby zajęcia bez nikogo odpowiedzialnego.
enum SubstituteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Session {
  id                  String  @id @default(cuid())
  templateId          String?
  locationId          String
  trainerId           String
  substituteTrainerId String?

  // Zastępstwo obowiązuje wyłącznie przy ACCEPTED. Patrz lib/domain/substitute.ts -
  // tam żyje jedyna definicja "kto realnie prowadzi te zajęcia".
  substituteStatus        SubstituteStatus?
  substituteRequestedAt   DateTime?         @db.Timestamptz
  substituteRespondedAt   DateTime?         @db.Timestamptz
  substituteRequestedById String? // User, który wyznaczył - do powiadomień i audytu
  // Zastępstwo od admina to polecenie (zastępca je przyjmuje do wiadomości),
  // od trenera to prośba (zastępca może odmówić). Rozróżnienie musi przetrwać
  // w bazie, bo od niego zależy, czy pokazujemy przycisk odmowy.
  substituteByAdmin       Boolean           @default(false)
  substituteDeclineReason String?
  name                    String
  kind                    SessionKind       @default(GROUP)
  startsAt                DateTime          @db.Timestamptz
  endsAt                  DateTime          @db.Timestamptz
  capacity                Int
  status                  SessionStatus     @default(SCHEDULED)
  cancelledReason         String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  categoryId String?

  // Kod QR tych zajęć - jednorazowy, losowany przy pierwszym pokazaniu na
  // stacji. Osobny dla każdych zajęć, więc kod raz sfotografowany nie wpuści
  // nikogo na kolejny trening.
  qrToken String? @unique

  // Odbicie prowadzącego: kto i kiedy. Bez tego nie da się stwierdzić, czy
  // trener był na sali przed zajęciami, czy dopisał obecność po fakcie.
  trainerCheckedInAt     DateTime? @db.Timestamptz
  trainerCheckedInUserId String?

  // Potwierdzenie obecności przez prowadzącego: liczba osób, którą zatwierdził,
  // i moment zatwierdzenia. Dopóki tego nie ma, lista obecności jest wstępna.
  attendanceConfirmedAt    DateTime? @db.Timestamptz
  attendanceConfirmedCount Int?

  category          ClassCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  template          ClassTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  location          Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  trainer           Trainer        @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  substituteTrainer Trainer?       @relation("SessionSubstitute", fields: [substituteTrainerId], references: [id], onDelete: SetNull)

  bookings    Booking[]
  attendances Attendance[]
  ratings     Rating[]

  @@unique([templateId, startsAt]) // idempotencja jobu generateSessions
  @@index([startsAt, locationId])
}

model Booking {
  id               String        @id @default(cuid())
  sessionId        String
  memberId         String
  status           BookingStatus @default(BOOKED)
  waitlistPosition Int?
  createdAt        DateTime      @default(now()) @db.Timestamptz
  cancelledAt      DateTime?     @db.Timestamptz

  // Powód odwołania podany przez klienta - trener widzi na rozpisce, czemu
  // kogoś nie ma, zamiast pustego miejsca.
  absenceReason    AbsenceReason?
  cancellationNote String?        @db.Text
  absenceReportId  String?

  // Karnet, z którego realnie zdjęto wejście przy spóźnionym odwołaniu.
  // Zapisany wprost, żeby zwrot trafił dokładnie tam, skąd wejście zeszło -
  // klient mógł w międzyczasie kupić nowy karnet.
  chargedPassId         String?
  entryRefundedAt       DateTime? @db.Timestamptz
  entryRefundedByUserId String?

  session         Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member          Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  absenceReport   AbsenceReport? @relation(fields: [absenceReportId], references: [id], onDelete: SetNull)
  chargedPass     Pass?          @relation("BookingChargedPass", fields: [chargedPassId], references: [id], onDelete: SetNull)
  entryRefundedBy User?          @relation("BookingEntryRefundedBy", fields: [entryRefundedByUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, memberId])
  @@index([memberId])
}

model Attendance {
  id               String           @id @default(cuid())
  sessionId        String
  memberId         String
  checkedInAt      DateTime         @default(now()) @db.Timestamptz
  method           AttendanceMethod // MANUAL nie liczy się do KPI trenera
  recordedByUserId String?

  session        Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member         Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedByUser User?   @relation("AttendanceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, memberId])
  @@index([memberId, checkedInAt])
}

// ---------------------------------------------------------------------------
// Retencja - serce systemu
// ---------------------------------------------------------------------------

enum NoteKind {
  CONTACT
  ONBOARDING
  GENERAL
}

model Note {
  id              String    @id @default(cuid())
  memberId        String
  authorUserId    String
  kind            NoteKind
  body            String    @db.Text // min. 30 znaków, walidacja na serwerze
  flaggedForAudit Boolean   @default(false) // próbka 10% miesięcznie do przeglądu
  reviewedAt      DateTime? @db.Timestamptz // właściciel zamknął przegląd tej notatki
  createdAt       DateTime  @default(now()) @db.Timestamptz

  member     Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  authorUser User   @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  onboardingSteps      OnboardingStep[]
  closedRetentionTasks RetentionTask[]

  @@index([memberId, createdAt])
  @@index([kind, flaggedForAudit])
}

model OnboardingStep {
  id          String    @id @default(cuid())
  memberId    String
  step        Int // 1 | 2 | 3
  dueAt       DateTime  @db.Timestamptz
  completedAt DateTime? @db.Timestamptz
  noteId      String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  note   Note?  @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@unique([memberId, step])
}

enum RetentionTaskType {
  INACTIVE_7
  INACTIVE_14
  RENEWAL
}

model RetentionTask {
  id            String            @id @default(cuid())
  memberId      String
  trainerId     String
  type          RetentionTaskType
  createdAt     DateTime          @default(now()) @db.Timestamptz
  dueAt         DateTime          @db.Timestamptz
  escalatedAt   DateTime?         @db.Timestamptz
  closedAt      DateTime?         @db.Timestamptz
  closingNoteId String? // zamknięcie WYMAGA notatki - egzekwowane w lib/domain, nie tylko w bazie

  member      Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer     Trainer @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  closingNote Note?   @relation(fields: [closingNoteId], references: [id], onDelete: SetNull)

  @@index([trainerId, closedAt])
  @@index([memberId, type, closedAt])
}

model ChurnReason {
  id                  String  @id @default(cuid())
  label               String
  trainerControllable Boolean

  surveys ChurnSurvey[]
}

model ChurnSurvey {
  id         String    @id @default(cuid())
  memberId   String
  sentAt     DateTime  @default(now()) @db.Timestamptz
  answeredAt DateTime? @db.Timestamptz
  reasonId   String?
  comment    String?   @db.Text

  member Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reason ChurnReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)
}

model Rating {
  id        String   @id @default(cuid())
  sessionId String
  memberId  String
  score     Int // 1-5
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
}

// ---------------------------------------------------------------------------
// Płatności - model gotówkowy, brak bramki, brak subskrypcji, brak webhooków
// ---------------------------------------------------------------------------

model Plan {
  id              String  @id @default(cuid())
  name            String
  priceGross      Int // grosze
  entriesPerMonth Int? // null = OPEN
  durationDays    Int     @default(30)
  forMinors       Boolean @default(false)
  // Karnet na treningi indywidualne. Klient potrafi mieć naraz karnet grupowy
  // i indywidualny - bez tego rozróżnienia wejście schodziło z tego, który
  // kończy się później, czyli często z niewłaściwego.
  forIndividual   Boolean @default(false)
  active          Boolean @default(true)

  passes     Pass[]
  promoCodes PromoCode[]
}

enum PassStatus {
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

model Pass {
  id                    String     @id @default(cuid())
  memberId              String
  planId                String
  // Uzgodniona cena tego karnetu w groszach - już po rabatach. Bez niej system
  // nie wie, czy klient dopłacił resztę: sama suma wpłat nic nie mówi, dopóki
  // nie ma do czego jej porównać. Zapisujemy przy sprzedaży, bo cennik planu
  // może się później zmienić, a ten karnet ma zostać rozliczony po swojej cenie.
  priceGross            Int        @default(0)
  startsAt              DateTime   @db.Timestamptz
  endsAt                DateTime   @db.Timestamptz
  entriesLeft           Int? // null dla OPEN
  status                PassStatus @default(ACTIVE)
  frozenAt              DateTime?  @db.Timestamptz
  frozenDaysUsed        Int        @default(0)
  renewalReminderSentAt DateTime?  @db.Timestamptz
  soldByUserId          String

  member     Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  soldByUser User      @relation("PassSoldBy", fields: [soldByUserId], references: [id], onDelete: Restrict)
  payments   Payment[]

  chargedBookings Booking[] @relation("BookingChargedPass")

  @@index([memberId, status])
  @@index([status, endsAt])
}

enum PaymentMethod {
  CASH
  BLIK
  TRANSFER
}

model Payment {
  id                String        @id @default(cuid())
  memberId          String
  passId            String?
  amountGross       Int // grosze - Payment jest append-only, korekta = nowy wpis z correctsPaymentId
  method            PaymentMethod
  locationId        String
  recordedByUserId  String
  recordedAt        DateTime      @default(now()) @db.Timestamptz
  correctsPaymentId String?
  note              String?       @db.Text
  // Kod rabatowy użyty przy tej sprzedaży (jeśli był). amountGross to już cena
  // PO rabacie - kod trzymamy dla raportów i historii.
  promoCodeId       String?

  member          Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  pass            Pass?     @relation(fields: [passId], references: [id], onDelete: SetNull)
  location        Location  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  recordedByUser  User      @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  correctsPayment Payment?  @relation("PaymentCorrection", fields: [correctsPaymentId], references: [id], onDelete: SetNull)
  corrections     Payment[] @relation("PaymentCorrection")
  promoCode       PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  // Sprzedaż karty podarunkowej: ta płatność jest przychodem za wydaną kartę.
  soldGiftCard    GiftCard?  @relation("GiftCardSalePayment")
  // Realizacje kart podarunkowych rozliczone tą płatnością (dopłata do karnetu).
  giftRedemptions GiftCardRedemption[]

  @@index([locationId, recordedAt])
  @@index([memberId, recordedAt])
}

// Rabat: procent (1-100) albo kwota w groszach. amountGross w Payment to zawsze
// cena PO rabacie - PromoCode służy walidacji przy sprzedaży i raportom.
enum DiscountKind {
  PERCENT
  AMOUNT
}

model PromoCode {
  id              String       @id @default(cuid())
  code            String       @unique
  kind            DiscountKind
  value           Int // PERCENT: 1-100 ; AMOUNT: grosze
  active          Boolean      @default(true)
  validFrom       DateTime?    @db.Timestamptz
  validUntil      DateTime?    @db.Timestamptz
  maxUses         Int? // null = bez limitu
  usedCount       Int          @default(0)
  planId          String? // null = kod działa na każdy plan
  note            String?      @db.Text
  createdByUserId String
  createdAt       DateTime     @default(now()) @db.Timestamptz

  plan     Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([active])
}

// Bon o określonej wartości. Przychód powstaje przy SPRZEDAŻY karty (soldPayment),
// a nie przy jej realizacji - realizacja to wykorzystanie już opłaconego kredytu,
// więc nie liczymy jej drugi raz do utargu.
model GiftCard {
  id              String    @id @default(cuid())
  code            String    @unique
  initialGross    Int
  balanceGross    Int
  active          Boolean   @default(true)
  validUntil      DateTime? @db.Timestamptz
  note            String?   @db.Text
  createdByUserId String
  createdAt       DateTime  @default(now()) @db.Timestamptz
  soldPaymentId   String?   @unique

  soldPayment Payment?             @relation("GiftCardSalePayment", fields: [soldPaymentId], references: [id], onDelete: SetNull)
  redemptions GiftCardRedemption[]

  @@index([active])
}

model GiftCardRedemption {
  id          String   @id @default(cuid())
  giftCardId  String
  paymentId   String? // płatność za karnet, do której doszła dopłata z karty
  amountGross Int
  createdAt   DateTime @default(now()) @db.Timestamptz

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

model CashDay {
  id              String    @id @default(cuid())
  locationId      String
  date            DateTime  @db.Date
  expectedGross   Int // suma Payment(CASH) tego dnia, grosze
  countedGross    Int?
  closedByUserId  String?
  closedAt        DateTime? @db.Timestamptz
  discrepancyNote String?   @db.Text

  location     Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  closedByUser User?    @relation("CashDayClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  @@unique([locationId, date])
}

// ---------------------------------------------------------------------------
// Zgody
// ---------------------------------------------------------------------------

model ConsentType {
  id            String  @id @default(cuid())
  key           String  @unique // "reg" | "rodo" | "health" | "image" | "guardian"
  label         String
  version       Int
  required      Boolean
  forMinorsOnly Boolean @default(false)
  bodyHtml      String  @db.Text // treść dostarcza prawnik, nie generuj

  consents Consent[]
}

model Consent {
  id              String    @id @default(cuid())
  memberId        String
  consentTypeId   String
  version         Int
  grantedAt       DateTime  @default(now()) @db.Timestamptz
  revokedAt       DateTime? @db.Timestamptz
  ipAddress       String
  userAgent       String
  grantedByUserId String // przy dziecku: opiekun prawny

  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  consentType   ConsentType @relation(fields: [consentTypeId], references: [id], onDelete: Restrict)
  grantedByUser User        @relation("ConsentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@index([memberId, consentTypeId])
}

// ---------------------------------------------------------------------------
// Reszta
// ---------------------------------------------------------------------------

enum ReferralStatus {
  SENT
  REGISTERED
  CONVERTED
  REWARDED
}

model Referral {
  id               String         @id @default(cuid())
  code             String         @unique
  referrerMemberId String
  refereeMemberId  String?
  status           ReferralStatus @default(SENT)
  convertedAt      DateTime?      @db.Timestamptz
  rewardedAt       DateTime?      @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz

  referrerMember Member  @relation("ReferralReferrer", fields: [referrerMemberId], references: [id], onDelete: Restrict)
  refereeMember  Member? @relation("ReferralReferee", fields: [refereeMemberId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Postępy i zgłoszenia (Faza 6)
// ---------------------------------------------------------------------------

model Measurement {
  id               String   @id @default(cuid())
  memberId         String
  weightKg         Float
  recordedAt       DateTime @default(now()) @db.Timestamptz
  recordedByUserId String

  member         Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedByUser User   @relation("MeasurementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([memberId, recordedAt])
}

enum AbsenceReason {
  INJURY
  OTHER
}

// Zgłoszenie z wyprzedzeniem (kontuzja/inny powód), żeby trener wiedział
// DLACZEGO klient nie trenuje, zamiast dostawać suchy alert INACTIVE_7/14
// bez kontekstu. resolvedAt=null = wciąż aktualne.
model AbsenceReport {
  id               String        @id @default(cuid())
  memberId         String
  reason           AbsenceReason
  note             String?       @db.Text
  reportedAt       DateTime      @default(now()) @db.Timestamptz
  expectedReturnAt DateTime?     @db.Date
  resolvedAt       DateTime?     @db.Timestamptz

  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([memberId, resolvedAt])
}

model TrainerScore {
  id              String   @id @default(cuid())
  trainerId       String
  period          String // "2026-07"
  ret90           Float?
  ret90Normalized Float?
  rating          Float?
  alertRate       Float?
  onboardingRate  Float?
  score           Int? // null gdy maturedCount < 5
  maturedCount    Int
  computedAt      DateTime @default(now()) @db.Timestamptz

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, period])
}

// ---------------------------------------------------------------------------
// Historia aktywności - kto co zrobił (admin widzi wszystkich, trener tylko
// siebie - patrz lib/auth/guard.ts i /admin/aktywnosc, /trainer/aktywnosc)
// ---------------------------------------------------------------------------

enum ActivityAction {
  MEMBER_CREATED
  MEMBER_UPDATED
  MEASUREMENT_ADDED
  PASS_SOLD
  PROMO_CODE_CREATED
  GIFT_CARD_SOLD
  PASS_FROZEN
  PASS_UNFROZEN
  PAYMENT_CORRECTED
  NOTE_ADDED
  ONBOARDING_STEP_COMPLETED
  RETENTION_TASK_CLOSED
  SESSION_CREATED
  SESSION_UPDATED
  SESSION_CANCELLED
  INDIVIDUAL_SESSION_BOOKED
  AVAILABILITY_WINDOW_CHANGED
  TRAINER_CREATED
  TRAINER_UPDATED
  TRAINER_DEACTIVATED
  TRAINER_REACTIVATED
  TRAINER_DELETED
  SETTINGS_UPDATED
  CATEGORY_CHANGED
  ABSENCE_REPORTED
  ENTRY_REFUNDED
  TRAINER_RATE_CHANGED
  COST_CHANGED
  SUBSTITUTE_REQUESTED
  SUBSTITUTE_ACCEPTED
  SUBSTITUTE_DECLINED
  SUBSTITUTE_CANCELLED
  PLAN_CHANGED
  // Na zajęciach odbił się trener, który ich nie prowadzi i nie ma
  // potwierdzonego zastępstwa. Push do właściciela bywa niedostarczony,
  // a to musi zostawić trwały ślad - patrz lib/services/class-qr.ts.
  TRAINER_CHECKIN_MISMATCH
}

model ActivityLog {
  id          String         @id @default(cuid())
  actorUserId String
  action      ActivityAction
  memberId    String?
  summary     String         @db.Text
  createdAt   DateTime       @default(now()) @db.Timestamptz

  actorUser User    @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  member    Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([memberId, createdAt])
}

// Token resetu hasła. Trzymamy WYŁĄCZNIE hash tokenu (jak hasła) - wyciek bazy
// nie może pozwolić na przejęcie kont. Surowy token żyje tylko w linku e-mail.
// Token potwierdzenia adresu e-mail przy rejestracji. Jak przy resecie hasla:
// trzymamy tylko hash, surowy token zyje wylacznie w linku.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Powiadomienia
// ---------------------------------------------------------------------------

enum NotificationType {
  BOOKING_CONFIRMATION
  SESSION_REMINDER
  BOOKING_SUGGESTION
  CHECK_IN
}

// Preferencja per (użytkownik, typ). Brak wiersza oznacza "wartość domyślna"
// z lib/domain/notification.ts - dzięki temu nie musimy zakładać wierszy przy
// tworzeniu konta ani migrować schematu przy dodaniu nowego typu.
model NotificationPreference {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType
  push   Boolean          @default(false)
  email  Boolean          @default(false)
  sms    Boolean          @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// Ślad wysłanego powiadomienia. Powód istnienia jest jeden: idempotencja
// jobów. Bez tego przypomnienie o tych samych zajęciach poszłoby przy każdym
// uruchomieniu cronu, a klient dostałby je pięć razy.
model NotificationLog {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  // Czego dotyczy - zwykle Session.id. Razem z typem tworzy klucz idempotencji.
  subjectId String
  sentAt    DateTime         @default(now()) @db.Timestamptz

  @@unique([userId, type, subjectId])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// Powiązanie rodzic - dziecko
// ---------------------------------------------------------------------------

enum LinkRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Prośba rodzica o wgląd w grafik dziecka. Dostęp do danych dziecka jest
// wrażliwy, więc rodzic tylko PROSI (podaje e-mail dziecka), a powiązanie
// aktywuje admin - dopiero zatwierdzenie ustawia Member.guardianUserId.
// childEmail to wpis rodzica; memberId dowiązujemy, gdy uda się dopasować
// kartotekę po tym adresie (login dziecka albo e-mail kontaktowy).
model GuardianLinkRequest {
  id               String            @id @default(cuid())
  requesterUserId  String
  childEmail       String
  memberId         String?
  status           LinkRequestStatus @default(PENDING)
  note             String?
  createdAt        DateTime          @default(now()) @db.Timestamptz
  resolvedAt       DateTime?         @db.Timestamptz
  resolvedByUserId String?

  requester User    @relation("GuardianLinkRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  member    Member? @relation("GuardianLinkMember", fields: [memberId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requesterUserId])
}

// ---------------------------------------------------------------------------
// Leady (CRM) - pozyskani z Meta (Facebook/Instagram), import CSV
// ---------------------------------------------------------------------------

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  META_OTHER
  MANUAL
}

enum LeadStatus {
  NEW // nowy, jeszcze nie obdzwoniony
  IN_PROGRESS // podjęto kontakt, w toku
  CALLBACK // umówiony ponowny kontakt (patrz reminderAt)
  CONFIRMED // potwierdził zainteresowanie - do założenia konta
  CONVERTED // założono konto (convertedMemberId)
  REJECTED // brak zainteresowania / rezygnacja
}

// Lead z kampanii Meta. Surowe pola z importu trzymamy w rawData, żeby nic nie
// zgubić niezależnie od układu kolumn w CSV. externalId to id leada z Meta -
// klucz deduplikacji przy imporcie (i późniejszym API). Po potwierdzeniu można
// z leada utworzyć konto klienta (convertedMemberId) - historia zostaje przy
// leadzie i przez to powiązanie jest dostępna także z karty klienta.
model Lead {
  id                String     @id @default(cuid())
  source            LeadSource @default(META_OTHER)
  externalId        String? // id z Meta (dedup)
  fullName          String
  email             String?
  phone             String?
  campaign          String? // nazwa kampanii / formularza
  rawData           Json? // wszystkie pola z importu
  status            LeadStatus @default(NEW)
  assignedToUserId  String? // kto obsługuje (admin/trener)
  reminderAt        DateTime?  @db.Timestamptz // termin ponownego kontaktu
  convertedMemberId String?    @unique
  importedAt        DateTime   @default(now()) @db.Timestamptz

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  assignedTo      User?   @relation("LeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  convertedMember Member? @relation("LeadMember", fields: [convertedMemberId], references: [id], onDelete: SetNull)

  notes      LeadNote[]
  activities LeadActivity[]

  @@unique([source, externalId])
  @@index([status])
  @@index([assignedToUserId])
  @@index([reminderAt])
}

// Notatka do leada - widoczna wyłącznie w panelu admina/trenera z dostępem.
model LeadNote {
  id           String   @id @default(cuid())
  leadId       String
  authorUserId String
  body         String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation("LeadNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([leadId])
}

enum LeadActivityKind {
  IMPORTED
  ASSIGNED
  STATUS_CHANGED
  REMINDER_SET
  NOTE_ADDED
  SUMMARY
  WELCOME_SMS
  WELCOME_EMAIL
  CONVERTED
}

// Historia aktywności leada: kiedy kontakt, co ustalono, zmiany statusu,
// przypomnienia, konwersja. Zostaje przy leadzie także po założeniu konta.
model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  actorUserId String?
  kind        LeadActivityKind
  summary     String
  createdAt   DateTime         @default(now()) @db.Timestamptz

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
}
