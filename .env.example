# Wzór konfiguracji. Skopiuj do .env i uzupełnij własnymi wartościami.
# Sam .env nigdy nie trafia do repozytorium.

# --- Baza -------------------------------------------------------------------
DATABASE_URL="postgresql://uzytkownik:haslo@host:5432/czapla"
# Używana wyłącznie przez `prisma migrate dev` do weryfikacji migracji.
SHADOW_DATABASE_URL="postgresql://uzytkownik:haslo@host:5432/czapla_shadow"

# --- Auth.js ----------------------------------------------------------------
# Wygeneruj: npx auth secret
AUTH_SECRET="zmien-mnie"

# --- Zadania cykliczne (Vercel Cron) ----------------------------------------
# Endpointy /api/cron/* odrzucają żądania bez tego tokenu.
CRON_SECRET="zmien-mnie"

# --- Powiadomienia push (Web Push / VAPID) ----------------------------------
# Wygeneruj parę kluczy: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:kontakt@czaplaboxing.pl"

# --- Powiadomienia e-mail (SMTP) --------------------------------------------
# Bez kompletu SMTP_HOST + SMTP_USER + SMTP_PASSWORD kanał e-mail jest
# nieaktywny, a ekran ustawień powiadomień pokazuje go jako niedostępny.
# Działa z hostingiem klubu, Gmailem i dostawcami transakcyjnymi.
SMTP_HOST=""
# 587 = STARTTLS (typowe), 465 = SMTPS.
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Adres nadawcy; gdy pusty, użyty zostanie SMTP_USER.
SMTP_FROM="Czapla Boxing <powiadomienia@czaplaboxing.pl>"

# --- Logowanie przez Google (OAuth) -----------------------------------------
# Opcjonalne. Bez tych kluczy przycisk "Zaloguj przez Google" się nie pokazuje,
# a logowanie działa tylko e-mailem i hasłem.
#
# Jak zdobyć (Google Cloud Console, https://console.cloud.google.com):
#  1. Utwórz projekt.
#  2. "APIs & Services" -> "OAuth consent screen": typ External, uzupełnij nazwę.
#  3. "Credentials" -> "Create credentials" -> "OAuth client ID" -> "Web application".
#  4. Authorized redirect URI: https://twojadomena.pl/api/auth/callback/google
#     (na lokalnym: http://localhost:3000/api/auth/callback/google)
#  5. Skopiuj Client ID i Client secret poniżej i zrestartuj aplikację.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Wiadomości SMS (SMSAPI.pl) ---------------------------------------------
# Dwa zastosowania: powitanie leada po rozmowie telefonicznej oraz kanał
# zapasowy, gdy push i e-mail zawiodą. Bez tokenu bramka jest nieaktywna -
# system nie udaje wysyłki, tylko zapisuje próbę jako "nie wysłano".
#
# Token zakłada się w panelu SMSAPI (Ustawienia -> Klucze API / OAuth).
SMSAPI_TOKEN=""
# Nazwa nadawcy widoczna na telefonie. Maksymalnie 11 znaków, bez polskich
# ogonków, wcześniej zatwierdzona w panelu SMSAPI. "CzaplaBoxing" ma dwanaście
# znaków i się nie zmieści - stąd "CzaplaBox".
SMSAPI_SENDER="CzaplaBox"

# Meta Lead Ads - automatyczny import leadów zamiast CSV.
# Adres webhooka do wpisania w panelu Meta: https://<domena>/api/leady/meta
# VERIFY_TOKEN i APP_SECRET wystarczą, żeby gniazdo przyjmowało zgłoszenia.
# ACCESS_TOKEN (token strony) dokłada automatyczne pobranie danych osoby -
# bez niego lead trafia do kartoteki jako "do uzupełnienia".
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
